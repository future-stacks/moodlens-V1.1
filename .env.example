# GEMINI_API_KEY: Google Gemini API key. Read only by the Express server
# (server/gemini.ts); never bundled into the client. Optional: without it,
# MoodLens serves suggestions from its built-in library.
# Locally: copy this file to .env. In production: inject it from a secrets manager.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: model id (default: gemini-3-flash-preview). Pin a stable model for production.
# GEMINI_MODEL=

# GEMINI_TIMEOUT_MS: give up on the AI and use the library after this long (default 15000).
# GEMINI_TIMEOUT_MS=15000

# PORT: port the Express server listens on (default 3000).
PORT=3000

# RATE_LIMIT_PER_MINUTE: intervention requests allowed per client IP per minute (default 20).
# RATE_LIMIT_PER_MINUTE=20

# TRUST_PROXY: number of reverse-proxy hops in front of the server (e.g. 1 behind
# an AWS load balancer), so rate limiting sees real client IPs. Leave unset locally.
# TRUST_PROXY=1
