# GEMINI_API_KEY: Required for Gemini AI API calls.
# Read only by the Express server (server/gemini.ts); it is never bundled into the client.
# Locally: copy this file to .env. In production: inject it as a server environment variable.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Port the Express server listens on (defaults to 3000).
PORT=3000
